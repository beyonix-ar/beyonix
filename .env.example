ANDREANI_ENV=QA
ANDREANI_TARIFF_ENV=QA
ANDREANI_QA_API_URL=https://apisqa.andreani.com
ANDREANI_QA_USERNAME=
ANDREANI_QA_PASSWORD=
ANDREANI_PROD_API_URL=https://apis.andreani.com
# Secrets de autenticación. Las mismas credenciales del ambiente persistido
# se reutilizan luego para tracking y etiqueta.
ANDREANI_PROD_USERNAME=
ANDREANI_PROD_PASSWORD=
# Datos comerciales asignados por Andreani. Mantener domicilio y sucursal en
# variables separadas; cambio/retiro no participan de una venta estándar.
ANDREANI_QA_CLIENT=
ANDREANI_QA_HOME_CONTRACT=
ANDREANI_QA_BRANCH_CONTRACT=
ANDREANI_QA_ORIGIN_BRANCH=RAC
ANDREANI_PROD_CLIENT=
ANDREANI_PROD_HOME_CONTRACT=
ANDREANI_PROD_BRANCH_CONTRACT=
ANDREANI_PROD_ORIGIN_BRANCH=RAC
# idgla numérico de la sucursal (campo "id" de GET /v2/sucursales), distinto
# del código anterior: POST /v2/ordenes-de-envio exige este id en
# origen.sucursal.id, y enviar el código ("RAC") devuelve
# "Sucursal con idgla RAC no encontrada" (confirmado en un intento real
# 2026-08-25). Resuelto para RAC/PROD vía GET /v2/sucursales?codigo=RAC:
# existen dos sucursales con ese código, usar la de canal "B2C" (10179), no
# la de canal "DMS" (30235, unidad de distribución interna).
ANDREANI_QA_ORIGIN_BRANCH_ID=
ANDREANI_PROD_ORIGIN_BRANCH_ID=
# Ambiente de CREACIÓN de envíos B2C, independiente de ANDREANI_TARIFF_ENV.
# Por defecto QA si no se define. Ver lib/andreani/order-shipment.ts.
ANDREANI_SHIPMENT_ENV=QA
# Segunda barrera obligatoria (además de ANDREANI_SHIPMENT_ENV=PROD) para
# poder crear envíos reales en PROD. Debe ser exactamente "true".
# El código además exige NODE_ENV=production: tests y `next dev` nunca pueden
# crear un envío PROD aunque esta variable quede activada por error.
ANDREANI_ALLOW_PROD_SHIPMENT_CREATION=false
# Tercera barrera, exclusiva de desarrollo local: por defecto debe quedar
# ausente o "false". NODE_ENV=test la ignora siempre (nunca hay POST real
# Andreani en tests). Solo activarla deliberadamente, junto con las dos
# variables anteriores en PROD, para una prueba manual controlada desde
# `next dev`. Nunca debe existir un equivalente NEXT_PUBLIC_ ni ser
# controlable desde el cliente.
ANDREANI_ALLOW_PROD_SHIPMENT_CREATION_IN_DEV=false
# Remitente B2C usado al crear envíos (opcional salvo el nombre; ver lib/andreani/order-shipment.ts)
ANDREANI_REMITENTE_NOMBRE=BEYONIX
ANDREANI_REMITENTE_EMAIL=
ANDREANI_REMITENTE_TELEFONO=
ANDREANI_REMITENTE_DOCUMENTO_TIPO=
ANDREANI_REMITENTE_DOCUMENTO_NUMERO=
FREE_SHIPPING_MIN_AMOUNT=
# Mismo valor expuesto al checkout para mantener el cálculo visual sincronizado.
NEXT_PUBLIC_FREE_SHIPPING_MIN_AMOUNT=
FREE_SHIPPING_MODE=full
NEXT_PUBLIC_FREE_SHIPPING_MODE=

# Emails transaccionales y notificaciones
NEXT_PUBLIC_SITE_URL=https://tudominio.com

# Mercado Pago (Checkout Pro)
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Firma secreta configurada en Tus integraciones > Webhooks
MERCADOPAGO_WEBHOOK_SECRET=
RESEND_API_KEY=
STORE_EMAIL_FROM=BEYONIX <regalos@tudominio.com>

# ARCA Factura Electrónica - homologación
# Los PEM pueden incluir saltos reales o la secuencia \n.
ARCA_CERT=
ARCA_PRIVATE_KEY=
ARCA_PRIVATE_KEY_PASSPHRASE=
ARCA_CUIT=
ARCA_PTO_VTA=
