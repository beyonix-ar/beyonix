ANDREANI_ENV=QA
ANDREANI_TARIFF_ENV=QA
ANDREANI_QA_API_URL=https://apisqa.andreani.com
ANDREANI_QA_USERNAME=
ANDREANI_QA_PASSWORD=
ANDREANI_PROD_API_URL=https://apis.andreani.com
ANDREANI_PROD_USERNAME=
ANDREANI_PROD_PASSWORD=
ANDREANI_QA_CLIENT=
ANDREANI_QA_HOME_CONTRACT=
ANDREANI_QA_BRANCH_CONTRACT=
ANDREANI_QA_ORIGIN_BRANCH=RAC
ANDREANI_PROD_CLIENT=
ANDREANI_PROD_HOME_CONTRACT=
ANDREANI_PROD_BRANCH_CONTRACT=
ANDREANI_PROD_ORIGIN_BRANCH=RAC
# Ambiente de CREACIÓN de envíos B2C, independiente de ANDREANI_TARIFF_ENV.
# Por defecto QA si no se define. Ver lib/andreani/order-shipment.ts.
ANDREANI_SHIPMENT_ENV=QA
# Segunda barrera obligatoria (además de ANDREANI_SHIPMENT_ENV=PROD) para
# poder crear envíos reales en PROD. Debe ser exactamente "true".
ANDREANI_ALLOW_PROD_SHIPMENT_CREATION=false
# Remitente B2C usado al crear envíos (opcional salvo el nombre; ver lib/andreani/order-shipment.ts)
ANDREANI_REMITENTE_NOMBRE=BEYONIX
ANDREANI_REMITENTE_EMAIL=
ANDREANI_REMITENTE_TELEFONO=
ANDREANI_REMITENTE_DOCUMENTO_TIPO=
ANDREANI_REMITENTE_DOCUMENTO_NUMERO=
FREE_SHIPPING_MIN_AMOUNT=
FREE_SHIPPING_MODE=full

# Emails transaccionales y notificaciones
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mercado Pago (Checkout Pro)
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Firma secreta configurada en Tus integraciones > Webhooks
MERCADOPAGO_WEBHOOK_SECRET=
RESEND_API_KEY=
STORE_EMAIL_FROM=BEYONIX <regalos@tudominio.com>
